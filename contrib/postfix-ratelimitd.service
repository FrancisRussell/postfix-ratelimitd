[Unit]
Description=Postfix recipient rate-limiting policy daemon
After=network.target redis-server.service redis.service valkey.service valkey-server.service
Wants=redis-server.service redis.service valkey.service valkey-server.service
Before=postfix.service

# Wants=/After= just start this after whichever of these four names (common
# Redis/Valkey unit names across distros) happens to be installed here - a
# soft dependency, safe to leave as-is whether or not any of them match, or
# Valkey is remote entirely.

[Service]
Type=simple
ExecStart=/usr/bin/postfix-ratelimitd --config /etc/postfix-ratelimitd/config.toml --log-target syslog
Restart=on-failure
RestartSec=2

# The user the daemon runs as.
User=postfix-ratelimitd

# Matches the default `server.socket` in contrib/config.toml. Postfix
# will need to be added to the postfix-ratelimitd group and not run
# inside a chroot to access /run/postfix-ratelimitd/ratelimit.sock.
RuntimeDirectory=postfix-ratelimitd
RuntimeDirectoryMode=0750

# For the chrooted-Postfix alternative location in contrib/config.toml
# (under /var/spool/postfix): comment out the two RuntimeDirectory= lines
# above, uncomment these two instead - ReadWritePaths= must target the
# parent, since ExecStartPre= is sandboxed too and the subdirectory
# doesn't exist yet. The postfix user will still need to be added to the
# postfix-ratelimitd group.
#ExecStartPre=/usr/bin/install -d -m 0750 -o postfix-ratelimitd -g postfix-ratelimitd /var/spool/postfix/postfix-ratelimitd
#ReadWritePaths=/var/spool/postfix

# No capabilities, privileges, or filesystem access beyond what's needed to
# read its config and create its own socket.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
