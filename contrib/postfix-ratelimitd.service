[Unit]
Description=Postfix recipient rate-limiting policy daemon
After=network.target redis-server.service redis.service valkey.service valkey-server.service
Wants=redis-server.service redis.service valkey.service valkey-server.service
Before=postfix.service

# The four names above are all commonly used names for the Redis/Valkey
# server's own unit. For a non-local instance, this daemon handles
# connection reliability itself at startup.

[Service]
Type=simple
ExecStart=/usr/bin/postfix-ratelimitd --config /etc/postfix-ratelimitd/config.toml --log-target syslog
Restart=on-failure
RestartSec=2

# A persistent postfix-ratelimitd system user/group is needed here, rather
# than DynamicUser=yes's ephemeral one, since Postfix needs a stable group
# name to be durably added to - see below.
User=postfix-ratelimitd

# Matches the default `server.socket` path in contrib/config.toml. Combined
# with the socket file itself being mode 0660, only this daemon's own user
# and members of its group can reach the socket at all - which by default is
# nobody but this daemon, since nothing else is in that group yet. Run
# `usermod -aG postfix-ratelimitd postfix` once, in either installation order
# relative to this package, to let Postfix in; its smtpd process picks up the
# new supplementary group on its next restart.
RuntimeDirectory=postfix-ratelimitd
RuntimeDirectoryMode=0750

# If instead using the chrooted-Postfix alternative socket location documented
# in contrib/config.toml (somewhere under /var/spool/postfix), replace the
# RuntimeDirectory= lines above with an explicit directory-creation step
# instead, e.g.:
#   ExecStartPre=/usr/bin/install -d -m 0750 -o postfix-ratelimitd -g postfix-ratelimitd /var/spool/postfix/postfix-ratelimitd
# The usermod step above still grants Postfix access either way - this
# alternative only changes where the socket file lives.

# No capabilities, privileges, or filesystem access beyond what's needed to
# read its config and create its own socket.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
UMask=0027

# Deliberately not PrivateNetwork=yes: Valkey/Redis may be reached over TCP or
# TLS, not just a unix socket, and a hostname-based redis:// URL needs DNS
# resolution too - PrivateNetwork=yes would sever all of that.
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
