[Unit]
Description=Postfix recipient rate-limiting policy daemon
After=network.target redis-server.service redis.service valkey.service
Wants=redis-server.service redis.service valkey.service
Before=postfix.service

# Referencing all three Redis/Valkey unit names above is deliberate, not a
# typo: systemd ignores an After=/Wants= naming a unit that doesn't exist on
# this system, and the actual name varies - redis-server.service on
# Debian/Ubuntu, plain redis.service on Fedora/RHEL/Arch, valkey.service
# where Valkey is packaged separately (e.g. Ubuntu 26.04 instead ships Valkey
# under the redis-server name). None of these directives do anything for a
# Valkey/Redis instance that isn't local and systemd-managed - that case is
# instead handled by this daemon's own bounded connection-retry logic at
# startup.

[Service]
Type=simple
ExecStart=/usr/bin/postfix-ratelimitd --config /etc/postfix-ratelimitd/config.toml --log-target syslog
Restart=on-failure
RestartSec=2

# Runs as its own dedicated, unprivileged identity rather than as `postfix` -
# a compromise of this daemon then can't inherit whatever wider privileges
# Postfix itself has. This assumes a static postfix-ratelimitd system
# user/group already exists - how to create one is a packaging decision
# (sysusers.d, useradd in a postinst script, etc.) left to whoever packages
# this. A persistent account is needed here, rather than DynamicUser=yes's
# ephemeral one, since Postfix needs a stable group name to be durably added
# to - see below.
User=postfix-ratelimitd

# Creates /run/postfix-ratelimitd, owned by postfix-ratelimitd:postfix-ratelimitd,
# mode 0750 - matches the default `server.socket` path in the example config.
# Combined with the socket file itself being mode 0660 (main.rs's
# SOCKET_MODE), only this daemon's own user and members of its group can
# reach the socket at all - which by default is nobody but this daemon, since
# nothing else is in that group yet. Run
# `usermod -aG postfix-ratelimitd postfix` once, in either installation order
# relative to this package, to let Postfix in; its smtpd process picks up the
# new supplementary group on its next restart.
RuntimeDirectory=postfix-ratelimitd
RuntimeDirectoryMode=0750

# If instead using the chrooted-Postfix alternative socket location documented
# in the example config (somewhere under /var/spool/postfix), RuntimeDirectory=
# can't help - that path isn't one systemd manages automatically. Replace the
# RuntimeDirectory= lines above with an explicit directory-creation step
# instead, e.g.:
#   ExecStartPre=/usr/bin/install -d -m 0750 -o postfix-ratelimitd -g postfix-ratelimitd /var/spool/postfix/postfix-ratelimitd
# usermod -aG postfix-ratelimitd postfix is still what grants Postfix access
# either way - this alternative only changes where the socket file lives.

# No capabilities, privileges, or filesystem access beyond what's needed to
# read its config and create its own socket.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0027

# Deliberately not PrivateNetwork=yes: Valkey/Redis may be reached over TCP or
# TLS, not just a unix socket, and a hostname-based redis:// URL needs DNS
# resolution too - PrivateNetwork=yes would sever all of that. This still
# blocks address families this daemon has no legitimate use for.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
